class HashTable {
 private class Entry {
 String key;
 String value;
 Entry(String key, String value) {
 this.key = key;
 this.value = value;
 }
 }
 private Entry[] table;
 private int size;
 public HashTable(int capacity) {
 table = new Entry[capacity];
 size = 0;
 }
 private int hash(String key) {
 return key.hashCode() % table.length;
 }
 public void insert(String key, String value) {
 if (size >= table.length / 2) {
 resize();
 }
int index = hash(key);
 while (table[index] != null) {
 if (table[index].key.equals(key)) {
 table[index].value = value; // Update existing key
 return;
 }
 index = (index + 1) % table.length; // Linear probing
 }
 table[index] = new Entry(key, value);
 size++;
 }
 public void delete(String key) {
 int index = hash(key);
 while (table[index] != null) {
 if (table[index].key.equals(key)) {
 table[index] = null; // Remove the key-value pair
 size--;
 return;
 }
 index = (index + 1) % table.length; // Linear probing
 }
 System.out.println("Key not found.");
 }
 public String search(String key) {
 int index = hash(key);
 while (table[index] != null) {
 if (table[index].key.equals(key)) {
 return table[index].value;
 }
 index = (index + 1) % table.length; // Linear probing
 }
 return null; // Key not found
 }
 public void display() {
 for (Entry entry : table) {
 if (entry != null) {
 System.out.println(entry.key + " : " + entry.value);
 }
 }
 }
 private void resize() {
 Entry[] oldTable = table;
 table = new Entry[oldTable.length * 2];
 size = 0;
for (Entry entry : oldTable) {
 if (entry != null) {
 insert(entry.key, entry.value);
 }
 }
 }
}
public class DictionaryDemo {
 public static void main(String[] args) {
 HashTable dict = new HashTable(10);
 dict.insert("apple", "A fruit that is sweet and crispy.");
 dict.insert("banana", "A yellow fruit that is soft.");
 dict.insert("cherry", "A small red fruit that is sweet.");
 System.out.println("Dictionary contents:");
 dict.display();
 // Search for a key
 System.out.println("Searching for 'banana': " + dict.search("banana"));
 System.out.println("Searching for 'grape': " + dict.search("grape"));
 // Delete a key-value pair
 System.out.println("Deleting 'banana'...");
 dict.delete("banana");
 System.out.println("Dictionary contents after deletion:");
 dict.display();
 }
}
